// Entra ID Token Replay - Unbound Token from Suspicious User Agent
// Detects successful authentications where the token is unbound (not tied to the originating device) combined with a non-standard user agent. AiTM-stolen session cookies are replayed through attacker tooling (Python requests, curl, custom scripts) that produce user agents distinct from the victim's normal browser.
// MITRE: T1550.004 - Use Alternate Authentication Material: Web Session Cookie


dataset = msft_azure_ad_raw
| alter
    error_code = json_extract_scalar(to_string(status), "$.errorCode"),
    Managed = json_extract_scalar(deviceDetail, "$.isManaged"),
    Compliance = json_extract_scalar(deviceDetail, "$.isCompliant"),
    Browser = json_extract_scalar(deviceDetail, "$.browser"),
    OS = json_extract_scalar(deviceDetail, "$.operatingSystem")
| filter error_code = "0"
| filter signInTokenProtectionStatus = "unbound"
| alter is_suspicious_ua = if(
    userAgent ~= "(?i)(python|requests|aiohttp|httpx|curl|axios|node|go-http|okhttp|urllib|postman)"
    or userAgent = null
    or userAgent = "", "YES", "NO")
// Flag unmanaged/non-compliant device
| alter is_unmanaged = if(Managed = "false" and Compliance = "false", "YES", "NO")
| fields _time, userPrincipalName, appDisplayName, ipAddress, location, userAgent, Browser, OS, is_suspicious_ua, is_unmanaged, Managed, Compliance, signInTokenProtectionStatus
| sort desc _time
