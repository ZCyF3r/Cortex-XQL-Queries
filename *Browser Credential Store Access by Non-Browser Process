// Browser Credential Store Access by Non-Browser Process
// Detects non-browser processes reading Chromium or Firefox credential and cookie databases. Infostealers and post-exploitation tools (Raccoon, RedLine, SharpChromium, HackBrowserData) target Login Data, Cookies, Web Data, and Local State to harvest saved passwords, session tokens, and autofill data.
// MITRE T1555.003 - Credentials from Password Stores: Credentials from Web Browsers, T1539 - Steal Web Session Cookie


dataset = xdr_data
| filter event_type = ENUM.FILE and event_sub_type in (ENUM.FILE_DIR_READ, ENUM.FILE_OPEN)
| filter action_file_path ~= "(?i)(Login Data|Cookies|Web Data|Local State|logins\.json|cookies\.sqlite|key[34]\.db)"
| filter action_file_path ~= "(?i)(Chrome|Edge|BraveSoftware|Chromium|Firefox|Opera)"
| filter actor_process_image_name not in ("chrome.exe", "msedge.exe", "brave.exe", "chromium.exe", "firefox.exe", "opera.exe")
| alter
    username = os_actor_primary_username,
    src_process = actor_process_image_name,
    src_cmdline = actor_process_command_line,
    src_path = actor_process_image_path,
    target_file = action_file_path
| fields _time, agent_hostname, username, src_process, src_path, src_cmdline, target_file
