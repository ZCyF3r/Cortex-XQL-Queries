// Kerberoasting - RC4 Encrypted TGS Request for Service Account
// Detects Kerberos TGS requests (Event 4769) using RC4 encryption (0x17) for service principal names. In environments where AES is the default, RC4 TGS requests indicate an attacker deliberately downgrading encryption to crack the service account's password offline.
// MITRE: T1558.003 - Steal or Forge Kerberos Tickets: Kerberoasting


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG
| filter action_evtlog_event_id = 4769
| alter aedf_str = to_string(action_evtlog_data_fields)
| alter
    TargetUser = arrayindex(regextract(aedf_str, "\"(?i)TargetUserName\":\s*\"([^\"]+)\""), 0),
    ServiceName = arrayindex(regextract(aedf_str, "\"(?i)ServiceName\":\s*\"([^\"]+)\""), 0),
    SourceIP = arrayindex(regextract(aedf_str, "\"(?i)IpAddress\":\s*\"([^\"]+)\""), 0),
    EncryptionType = arrayindex(regextract(aedf_str, "\"(?i)TicketEncryptionType\":\s*\"([^\"]+)\""), 0),
    TicketOptions = arrayindex(regextract(aedf_str, "\"(?i)TicketOptions\":\s*\"([^\"]+)\""), 0),
    Status = arrayindex(regextract(aedf_str, "\"(?i)Status\":\s*\"([^\"]+)\""), 0)
| filter EncryptionType ~= "0x17"
| filter Status ~= "0x0"
| filter ServiceName not contains "$"
| filter ServiceName != "krbtgt"
| filter TargetUser != ServiceName
| fields _time, agent_hostname, TargetUser, ServiceName, SourceIP, EncryptionType, TicketOptions, Status
| sort desc _time
