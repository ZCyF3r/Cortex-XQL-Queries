// Kubernetes Container File System Activity
// File creates, writes, modifications, and permission changes inside containers.
// MITRE: T1105 - Ingress Tool Transfer, T1036 - Masquerading


dataset = xdr_data
| filter event_type = ENUM.FILE
| filter event_sub_type in (ENUM.FILE_CREATE_NEW, ENUM.FILE_WRITE, ENUM.FILE_CHANGE_MODE, ENUM.FILE_LINK)
| filter actor_process_container_id != null
| alter container_info_str = to_string(actor_container_info)
| alter
    container_name  = json_extract_scalar(container_info_str, "$.name"),
    container_image = json_extract_scalar(container_info_str, "$.image_name"),
    pod_name = json_extract_scalar(container_info_str, "$.pod_name"),
    pod_namespace = json_extract_scalar(container_info_str, "$.pod_namespace"),
    is_privileged = json_extract_scalar(container_info_str, "$.privileged")
| fields _time, agent_hostname, pod_namespace, pod_name, container_name, container_image, is_privileged, event_sub_type, actor_process_image_name, action_file_path, action_process_image_command_line
| sort desc _time
