// SharePoint Access from Scripting User Agent (Automated Collection)
// Detects any SharePoint file access using a scripting/automation user agent.
// MITRE: T1530 - Data from Cloud Storage


dataset = saas_audit_logs
| filter service_type ~= "SharePoint"
| filter user_agent ~= "(?i)(python-requests|python-urllib|aiohttp|httpx|Go-http)"
| alter
    anonymousTunnel = json_extract_scalar(caller_ip_enrichment, "$.tunnels_anonymous"),
    IsVPN = json_extract_scalar(caller_ip_enrichment, "$.tunnels_type"),
    VPNOperator = json_extract_scalar(caller_ip_enrichment, "$.tunnels_operator"),
    infrastructure = json_extract_scalar(caller_ip_enrichment, "$.infrastructure")
| alter is_scripted_ua = if(user_agent contains "python-requests/2.28.1", "YES", "NO")
| comp
    count() as total_operations,
    count_distinct(operation_name_orig) as distinct_ops,
    count_distinct(referenced_resource_name) as distinct_files,
    values(operation_name_orig) as operations,
    values(caller_ip) as source_ips,
    values(infrastructure) as infra_types,
    values(is_helix_ip) as helix_ip_match,
    values(is_helix_ua) as helix_ua_match,
    min(_time) as first_seen,
    max(_time) as last_seen
  by identity_name, user_agent
| sort desc total_operations
