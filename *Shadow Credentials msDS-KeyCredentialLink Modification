// Shadow Credentials msDS-KeyCredentialLink Modification
// Detects additions to the msDS-KeyCredentialLink attribute (Event 5136, DSType %%14676 = Value Added). Shadow Credentials attacks (Whisker, pyWhisker, DSInternals) plant an attacker-controlled public key on a user or computer object, enabling PKINIT authentication as that account without knowing the password. Legitimate writes come from Windows Hello for Business enrollment and Azure AD Connect, anything else is suspicious.
// Pair with the PKINIT baseline (Event 4768, PreAuthType 16) to detect the subsequent certificate authentication.
// MITRE T1556.004 - Modify Authentication Process: Network Device Authentication, T1649 - Steal or Forge Authentication Certificates


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id = 5136
| fields action_evtlog_data_fields as aedf, agent_hostname
| filter aedf != null
| alter
    SubjectUserName = aedf -> SubjectUserName,
    SubjectDomainName = aedf -> SubjectDomainName,
    ObjectDN = aedf -> ObjectDN,
    ObjectClass = aedf -> ObjectClass,
    AttributeLDAPDisplayName = aedf -> AttributeLDAPDisplayName,
    AttributeValue = aedf -> AttributeValue,
    DSType = aedf -> DSType
//| filter agent_hostname = "REPLACE"
| filter AttributeLDAPDisplayName = "msDS-KeyCredentialLink"
| filter DSType = "%%14676"
| filter SubjectUserName not contains "MSOL"
| fields _time, agent_hostname, SubjectUserName, SubjectDomainName, ObjectDN, ObjectClass, AttributeValue, DSType
