// M365 Bulk Data Exfiltration - Automated Collection via Proxy or Hosted Infrastructure
// Detects high-volume Exchange and SharePoint activity from a single identity where the source is hosted/datacenter infrastructure, a residential proxy, or a scripting user agent (python-requests, aiohttp, etc.). 
// Helix and similar data-extortion groups authenticate from residential proxies aligned to victim geography, then pivot to hosted infrastructure for automated bulk download.
// Actor: Helix / BlackFile / ShinyHunters (data extortion ecosystem)
// Reference: https://reliaquest.com/blog/threat-spotlight-helix-new-name-in-data-extortion-ecosystem/
// MITRE: T1530 - Data from Cloud Storage, T1213.002 - Data from Information Repositories: Sharepoint, T1114.002 - Email Collection: Remote Email Collection, T1567 - Exfiltration Over Web Service


dataset = saas_audit_logs
| filter service_type in(ENUM.Exchange, ENUM.SharePoint)
| alter
    anonymousTunnel = json_extract_scalar(caller_ip_enrichment, "$.tunnels_anonymous"),
    IsVPN = json_extract_scalar(caller_ip_enrichment, "$.tunnels_type"),
    VPNOperator = json_extract_scalar(caller_ip_enrichment, "$.tunnels_operator"),
    infrastructure = json_extract_scalar(caller_ip_enrichment, "$.infrastructure"),
    IsProxy = json_extract_array(caller_ip_enrichment, "$.client_proxies"),
    ScriptedUA = json_extract_scalar(raw_log, "$.ClientInfoString")
| alter is_scripted_ua = if(ScriptedUA ~= "(?i)(python-requests|python-urllib|aiohttp|httpx|Go-http)", "YES", "NO")
| alter is_hosted = if(
    infrastructure ~= "(?i)(hosting|datacenter|cloud|server)" or IsVPN != null,
    "YES", "NO")
| alter is_proxy = if(array_length(IsProxy) > 0, "YES", "NO")
| comp
    count() as total_downloads,
    count_distinct(referenced_resource_name) as distinct_files,
    count_distinct(caller_ip) as distinct_ips,
    values(caller_ip) as source_ips,
    values(is_scripted_ua) as scripted_ua,
    values(is_hosted) as hosted_infra,
    values(is_proxy) as proxy_used,
    values(user_agent) as user_agents,
    values(caller_ip_geolocation) as geolocations,
    min(_time) as first_seen,
    max(_time) as last_seen
      by identity_name
| filter total_downloads >= 10000 and distinct_files >= 10000
| filter hosted_infra = "YES" or proxy_used = "YES" or scripted_ua = "YES"
| alter severity = if(
    scripted_ua contains "YES", "CRITICAL - Automated Exfiltration",
    if(proxy_used contains "YES", "HIGH - Proxy Infrastructure",
    if(hosted_infra contains "YES", "HIGH - Hosted Infrastructure",
    "MEDIUM - Elevated Volume")))
| sort desc total_downloads
