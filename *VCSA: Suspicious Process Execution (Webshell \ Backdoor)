// VCSA Process Execution — Armory Castle Tooling
// Detects execution of known Armory Castle tools via VCSA SYSCALL audit logs: BONESAW (/tmp/123), SAWSNAKE (/tmp/sss),
// BEARBONES (/tmp/dbr), LAZYBONES (/usr/bin/vmtoolscs), and SLIMSAVAGE/CAGEMATCH webshells. Also catches suspicious
// download/staging activity in /tmp/. Allowlist legitimate /tmp/ usage from vmware services if needed.
// MITRE: T1059 — Command and Scripting Interpreter


dataset = vmware_vsphere_raw
| filter _raw_log ~= "(?i)(SYSCALL|execve|type=EXECVE|vcsa-audit)"
| filter _raw_log ~= "(?i)(/tmp/123|/tmp/sss|/tmp/dbr|/usr/bin/vmtoolscs|/tmp/[a-z0-9]{1,4}\b)"
   or _raw_log ~= "(?i)(\.py\s|python.*-c|bash\s+-[ic]|sh\s+-c|wget\s|curl\s.*-o|chmod\s+\+x.*/tmp)"
| alter
    process_path = coalesce(
        arrayindex(regextract(_raw_log, "exe\s*=\s*\"([^\"]+)\""), 0),
        arrayindex(regextract(_raw_log, "(?i)comm\s*=\s*\"([^\"]+)\""), 0)
    ),
    command_line = arrayindex(regextract(_raw_log, "(?i)(?:cmdline|a0|EXECVE).*?\"(.+?)\""), 0),
    process_pid = arrayindex(regextract(_raw_log, "pid\s*=\s*(\d+)"), 0),
    parent_pid = arrayindex(regextract(_raw_log, "ppid\s*=\s*(\d+)"), 0),
    exec_uid = arrayindex(regextract(_raw_log, "uid\s*=\s*(\d+)"), 0)
| alter severity = if(
    _raw_log ~= "(?i)(/tmp/123|/tmp/sss|/tmp/dbr|/usr/bin/vmtoolscs)",
        "CRITICAL — Known Armory Castle tool path",
    if(_raw_log ~= "(?i)(chmod\s+\+x.*/tmp|curl.*-o.*/tmp|wget.*/tmp)",
        "HIGH — Suspicious download/staging in /tmp",
        "MEDIUM — Suspicious process execution on VCSA"))
| alter tool_match = if(
    _raw_log contains "/tmp/123", "BONESAW",
    if(_raw_log contains "/tmp/sss", "SAWSNAKE",
       if(_raw_log contains "/tmp/dbr", "BEARBONES",
          if(_raw_log contains "/usr/bin/vmtoolscs", "LAZYBONES",
             ""))))
| fields _time, severity, tool_match, process_path, command_line, process_pid, parent_pid, exec_uid, _raw_log
| sort asc _time
