// Payroll Pirates Anomalous MailItemsAccessed AppID\API Pairing
// Detects mailbox access using the specific ClientAppId and API pairing unique to the Storm-2755 / Payroll Pirates AiTM campaign. Access type "Bind" confirms message content was retrieved. Campaign targets payroll, HR, and finance personnel mailboxes.
// Reference: https://arcticwolf.com/resources/blog/payroll-pirates-strange-new-tides-in-business-email-compromise/
// MITRE T1114.002 - Email Collection: Remote Email Collection, T1550.001 - Use Alternate Authentication Material: Application Access Token


dataset = saas_audit_logs 
| alter
    API_ID = json_extract_scalar(raw_log, "$.AppAccessContext.APIId"),
    Mail_Operation_Type = json_extract_array(raw_log, "$.OperationProperties")
| filter service_type = ENUM.Exchange 
| filter API_ID = "c999ed3e-27ae-4cb3-b3a2-46b056af63d3"
| filter identity_invoked_by_uuid = "5d661950-3475-41cd-a2c3-d671a3162bc1"
| filter operation_name_orig = "MailItemsAccessed"
| filter user_agent ~= "(?i)(firefox)"
| fields _time, event_timestamp, identity_name, identity_invoked_by_uuid, operation_name_orig,operation_status, API_ID, user_agent, user_agent_data, caller_ip, caller_ip_asn, caller_ip_asn_org, caller_ip_geolocation, caller_ip_enrichment, raw_log
