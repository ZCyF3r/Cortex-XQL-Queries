// Remote Task Creation via ATSVC RPC (atexec Legacy AT Scheduler)
// Detects remote task creation through the legacy AT scheduler interface. Impacket atexec uses NetrJobAdd (opnum 0) to create scheduled tasks on remote hosts.
// MITRE: T1053.002 - Scheduled Task/Job: At


dataset = xdr_data
| filter event_type = ENUM.RPC_CALL
| filter action_rpc_interface_uuid = "{1FF70682-0A51-30E8-076D-740BE8CEE98B}"
| filter action_rpc_func_opnum = 0
| alter call_fields_str = to_string(action_rpc_func_str_call_fields)
| fields _time, agent_hostname, os_actor_primary_username, action_rpc_interface_name, action_rpc_interface_uuid, event_rpc_interface_uuid, event_rpc_func_opnum, action_rpc_func_opnum, action_rpc_func_name, call_fields_str, action_rpc_username, actor_remote_ip, causality_actor_type
