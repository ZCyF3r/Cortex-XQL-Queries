// HOLLOWGRAPH - Anomalous Calendar Operations via Graph API
// Detects Graph API requests creating calendar events, uploading attachments to events, or modifying event subjects. HOLLOWGRAPH uses a compromised M365 mailbox calendar as a two-way C2 dead-drop, creating events dated 2050-05-13, attaching encrypted exfil as File{n}.txt, and renaming subjects to Boss{..}ID{..} tags.
// Reference https://www.group-ib.com/blog/hollowgraph-microsoft-365/
// MITRE T1071.001 - Application Layer Protocol: Web Protocols, T1567 - Exfiltration Over Web Service


dataset = cloud_audit_logs
| filter log_name = "microsoft_graph_activity_logs"
| filter operation_name_orig ~= "(?i)(calendar|events|attachments)"
| alter is_event_create = if(operation_name = "operation_name_POST"
    and operation_name_orig ~= "(?i)/calendar/events", "YES", "NO")
| alter is_attachment_upload = if(operation_name = "operation_name_POST"
    and operation_name_orig ~= "(?i)/attachments", "YES", "NO")
| alter is_event_modify = if(operation_name = "operation_name_POST"
    and operation_name_orig ~= "(?i)/events/", "YES", "NO")
| alter is_calendar_view = if(operation_name = ENUM.Get 
    and operation_name_orig ~= "(?i)calendarView", "YES", "NO")
| filter is_event_create = "YES"
    or is_attachment_upload = "YES"
    or is_event_modify = "YES"
    or is_calendar_view = "YES"
| fields _time, identity_name, operation_name, operation_name_orig, caller_ip, caller_ip_asn_org, caller_ip_geolocation, user_agent, is_event_create, is_attachment_upload, is_event_modify, is_calendar_view, raw_log



dataset = cloud_audit_logs
| filter log_name = "microsoft_graph_activity_logs"
| filter operation_name_orig ~= "(?i)(calendar|events|attachments)"
| alter is_event_create = if(operation_name = "operation_name_POST"
    and operation_name_orig ~= "(?i)/calendar/events", "YES", "NO")
| alter is_attachment_upload = if(operation_name = "operation_name_POST"
    and operation_name_orig ~= "(?i)/attachments", "YES", "NO")
| alter is_event_modify = if(operation_name = "operation_name_POST"
    and operation_name_orig ~= "(?i)/events/", "YES", "NO")
| alter is_calendar_view = if(operation_name = ENUM.Get 
    and operation_name_orig ~= "(?i)calendarView", "YES", "NO")
| filter is_event_create = "YES"
    or is_attachment_upload = "YES"
    or is_event_modify = "YES"
    or is_calendar_view = "YES"
| alter raw_str = to_string(raw_log)
| alter is_app_identity = if(identity_name not contains "@", "YES", "NO")
| alter has_future_date = if(operation_name_orig ~= "(?i)(2050|2049|2048)", "YES", "NO")
| alter has_boss_subject = if(operation_name_orig  ~= "(?i)Boss\{", "YES", "NO")
| alter has_eventid_subject = if(operation_name_orig contains "(?i)(Event ID:)", "YES", "NO")
| alter has_file_attachment = if(raw_str ~= "FIle\\d+\\.txt", "YES", "NO")
| alter has_suspcious_ua = if(
    user_agent not contains "Outlook" and
    user_agent not contains "Edge" and
    user_agent not contains "Chrome" and
    user_agent not contains "Safari", "YES", "NO")
| alter signal_count = add(
    if(is_app_identity = "YES", 1, 0),
    if(has_future_date = "YES", 1, 0),
    if(has_boss_subject = "YES", 1, 0),
    if(has_eventid_subject = "YES", 1, 0),
    if(has_file_attachment = "YES", 1, 0),
    if(has_suspcious_ua = "YES", 1, 0))
