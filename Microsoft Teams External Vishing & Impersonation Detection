// Microsoft Teams External Vishing & Impersonation Detection
// Detects external calls involving screen sharing and impersonation of trusted entities
// Screen share during external call = high risk credential theft / RAT installation vector
// Includes filtering for Free/abused TLDs, Cheap/throwaway TLDs, Phishing-common TLDs, High-risk specialty TLDs, & PHaaS kit TLDs
// Uncomment for specific identity, screenshare artifact, or username impersonation


dataset = saas_audit_logs
| alter 
    UserType = json_extract_scalar(raw_log, "$.Attendees[0].RecipientType"),
    UserName = json_extract_scalar(raw_log, "$.Attendees[0].DisplayName"),
    UserObjectID = json_extract_scalar(raw_log, "$.Attendees[0].UserObjectId"),
    UPN = json_extract_scalar(raw_log, "$.Attendees[0].UPN"),
    Artifact_Session_Start = json_extract_scalar(raw_log, "$.ArtifactsShared[0].ArtifactShareSessions[0].StartTimestamp"),
    Artifact_Session_End = json_extract_scalar(raw_log, "$.ArtifactsShared[0].ArtifactShareSessions[0].EndTimestamp"),
    Artifact_Share_ID = json_extract_scalar(raw_log, "$.ArtifactsShared[0].ArtifactShareSessions[0].ScreenShareId"),
    JoinTime = json_extract_scalar(raw_log, "$.JoinTime"),
    LeaveTime = json_extract_scalar(raw_log, "$.LeaveTime"),
    Artifact_Name = json_extract_scalar(raw_log, "$.ArtifactsShared[0].ArtifactSharedName"),
    CallID = json_extract_scalar(raw_log, "$.CallId"),
    CallStatus = json_extract_scalar(raw_log, "$.ItemName")
| filter service_type = "MicrosoftTeams"
| filter operation_name_orig = "CallParticipantDetail"
//| filter identity_name = "<IDENTITY>"
//| filter Artifact_Name = "screenShared"
| filter identity_name ~= "(?i)^(?:\b(?:help(?:desk)?|it|service|support|tech|abuse|admin(?:istrator)?|account|alert|assistant|audit|authentication|azure|compliance|corporate|cyber|domain|duo|emergency|entra|finance|fraud|hr|human|identity|incident|legal|m365|mfa|microsoft|network|notification|okta|operations|password|payable|payroll|reset|security|sharepoint|soc|system|teams|threat|verif(?:y|ication))\b.*(?:admin(?:istrator)?|agent|bot|department|desk|resources|support|technician)?)"
    or UserName ~= "(?i)^(?:\b(?:help(?:desk)?|it|service|support|tech|abuse|admin(?:istrator)?|account|alert|assistant|audit|authentication|azure|compliance|corporate|cyber|domain|duo|emergency|entra|finance|fraud|hr|human|identity|incident|legal|m365|mfa|microsoft|network|notification|okta|operations|password|payable|payroll|reset|security|sharepoint|soc|system|teams|threat|verif(?:y|ication))\b.*(?:admin(?:istrator)?|agent|bot|department|desk|resources|support|technician)?)"
    or identity_name ~= "(?i)\.(top|xyz|club|buzz|icu|cyou|sbs|live|online|site|fun|store|vip|work|rest|space|link|click)"
| fields _time, identity_name, UserName, service_type, operation_name_orig, UserType, UserObjectID, UPN, JoinTime, LeaveTime, Artifact_Name, Artifact_Share_ID, Artifact_Session_Start, Artifact_Session_End, CallID, CallStatus, raw_log
