// Shadow Credentials Addition & PKINIT Authentication
// Correlates an msDS-KeyCredentialLink addition (Event 5136) with a subsequent successful PKINIT authentication (Event 4768) on the same account. Resolves CN display name to sAMAccountName via AD inventory.
// MITRE: T1556.004 - Modify Authentication Process: Network Device Authentication, T1649 - Steal or Forge Authentication Certificates, T1558 - Steal or Forge Kerberos Tickets


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id = 5136
| fields action_evtlog_data_fields as aedf, agent_hostname as target_dc, _time as keyaddition_time
| filter aedf != null
| alter aedf_str = to_string(aedf)
| alter
    InitatorSubjectName = arrayindex(regextract(aedf_str, "\"(?i)SubjectUserName\":\s*\"([^\"]+)\""), 0),
    InitatorSubjectDomain = arrayindex(regextract(aedf_str, "\"(?i)SubjectDomainName\":\s*\"([^\"]+)\""), 0),
    ObjectDN = arrayindex(regextract(aedf_str, "\"(?i)ObjectDN\":\s*\"([^\"]+)\""), 0),
    ObjectClass = arrayindex(regextract(aedf_str, "\"(?i)ObjectClass\":\s*\"([^\"]+)\""), 0),
    AttributeLDAPDisplayName = arrayindex(regextract(aedf_str, "\"(?i)AttributeLDAPDisplayName\":\s*\"([^\"]+)\""), 0),
    AttributeValue = arrayindex(regextract(aedf_str, "\"(?i)AttributeValue\":\s*\"([^\"]+)\""), 0),
    DSType = arrayindex(regextract(aedf_str, "\"(?i)DSType\":\s*\"([^\"]+)\""), 0)
| filter AttributeLDAPDisplayName = "msDS-KeyCredentialLink"
| filter DSType ~= "%%14676"
| alter TargetAccountRaw = arrayindex(regextract(ObjectDN, "(?i)^CN=([^,]+)"), 0)
| alter TargetAccountKey = lowercase(TargetAccountRaw)
| join type=left (preset=ad_users
    | fields name, sam_account_name
    | alter ad_name_key = lowercase(name)) as aduser aduser.ad_name_key = TargetAccountKey
| alter TargetAccountKey = lowercase(coalesce(sam_account_name, TargetAccountRaw))
| join type=inner (
    dataset = xdr_data
    | filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id = 4768
    | fields action_evtlog_data_fields as aedf2, agent_hostname as auth_dc, _time as auth_time
    | filter aedf2 != null
    | alter aedf2_str = to_string(aedf2)
    | alter
        AuthUser = arrayindex(regextract(aedf2_str, "\"(?i)TargetUserName\":\s*\"([^\"]+)\""), 0),
        AuthSid = arrayindex(regextract(aedf2_str, "\"(?i)TargetSid\":\s*\"([^\"]+)\""), 0),
        AuthSourceIP = arrayindex(regextract(aedf2_str, "\"(?i)IpAddress\":\s*\"([^\"]+)\""), 0),
        AuthStatus = arrayindex(regextract(aedf2_str, "\"(?i)Status\":\s*\"([^\"]+)\""), 0),
        AuthPreAuthType = arrayindex(regextract(aedf2_str, "\"(?i)PreAuthType\":\s*\"([^\"]+)\""), 0),
        AuthCertIssuer = arrayindex(regextract(aedf2_str, "\"(?i)CertIssuerName\":\s*\"([^\"]+)\""), 0),
        AuthCertSerial = arrayindex(regextract(aedf2_str, "\"(?i)CertSerialNumber\":\s*\"([^\"]+)\""), 0),
        AuthTicketEncryption = arrayindex(regextract(aedf2_str, "\"(?i)TicketEncryptionType\":\s*\"([^\"]+)\""), 0)
    | filter AuthStatus = "0x0"
    | filter AuthPreAuthType = "16"
    | filter AuthCertIssuer not contains "login.windows.net"
    | alter AuthUserKey = lowercase(replace(AuthUser, "$", ""))
) as pkinit pkinit.AuthUserKey = TargetAccountKey
| fields keyaddition_time, auth_time, InitatorSubjectName, InitatorSubjectDomain, TargetAccountRaw, TargetAccountKey, ObjectDN, ObjectClass, AuthSourceIP, AuthCertIssuer, AuthCertSerial, AuthSid, AuthTicketEncryption, target_dc, auth_dc
| sort asc keyaddition_time
