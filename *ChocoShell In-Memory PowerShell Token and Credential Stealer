// ChocoShell In-Memory PowerShell Token and Credential Stealer
// Detects behavioral indicators of ChocoShell, the CaptiveCrunch campaign's PowerShell-based infostealer. ChocoShell runs entirely in-memory, disables AMSI before execution, accesses Web Account Manager tokens (.tbres files in Token Broker cache), steals WiFi credentials, disables Defender signature updates, and communicates through CornFlake's localhost HTTP API (/upload, /reload, /status).
// Reference https://www.microsoft.com/en-us/security/blog/2026/07/31/captivecrunch-midnight-blizzard-targets-travelers-worldwide-for-malware-delivery-and-credential-theft/
// MITRE T1059.001 - Command and Scripting Interpreter: PowerShell, T1555.003 - Credentials from Password Stores: Credentials from Web Browsers, T1528 - Steal Application Access Token T1562.001 - Impair Defenses: Disable or Modify Tools


dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("powershell.exe", "pwsh.exe", "cmd.exe")
| filter action_process_image_name in ("powershell.exe", "pwsh.exe")
| filter
    action_process_image_command_line ~= "(?i)(AmsiUtils|amsiInitFailed|AmsiScanBuffer|SetValue.*AmsiEnable|Reflection\.Assembly.*amsi)"
    or
    action_process_image_command_line ~= "(?i)(TokenBroker|\.tbres|Microsoft\.AAD\.BrokerPlugin)"
    or
    action_process_image_command_line ~= "(?i)(netsh.*wlan.*show.*profiles|Wlansvc\\Profiles|wlan.*key=clear)"
    or
    action_process_image_command_line ~= "(?i)(Set-MpPreference.*DisableSignatureRetirement|Update-MpSignature.*Disable|MpPreference.*SignatureUpdate)"
    or
    action_process_image_command_line ~= "(?i)(localhost.*/upload|localhost.*/reload|localhost.*/status|127\.0\.0\.1.*/upload|127\.0\.0\.1.*/reload|127\.0\.0\.1.*/status)"
    or
    action_process_image_command_line ~= "(?i)(fodhelper|computerdefaults|sdclt|eventvwr.*mmc)"
| alter indicator_type = if(
    action_process_image_command_line ~= "(?i)(AmsiUtils|amsiInitFailed|AmsiScanBuffer)", "AMSI Bypass",
    if(action_process_image_command_line ~= "(?i)(TokenBroker|\.tbres)", "Token Theft",
    if(action_process_image_command_line ~= "(?i)(netsh.*wlan|Wlansvc)", "WiFi Credential Theft",
    if(action_process_image_command_line ~= "(?i)(MpPreference|SignatureUpdate)", "Defender Disable",
    if(action_process_image_command_line ~= "(?i)(localhost.*/upload|127\.0\.0\.1.*/upload)", "CornFlake API Comms",
    if(action_process_image_command_line ~= "(?i)(fodhelper|computerdefaults|sdclt|eventvwr)", "UAC Bypass", "Unknown"))))))
| fields _time, agent_hostname, os_actor_primary_username, actor_process_image_name, action_process_image_name, action_process_image_command_line, indicator_type
