// CertLog Database Exfiltration - Remote Read of CA Database
// Detects file reads from the CertLog directory by processes other than certsvc.exe. The CA database (.edb) contains all issued certificates and, if key archival is enabled, archived private keys. 
// Remote reads via SMB (System PID 4) indicate an attacker on the network copying the CA database for offline extraction of certificates and keys.
// MITRE: T1005 - Data from Local System, T1552.004 - Unsecured Credentials: Private Keys, T1649 - Steal or Forge Authentication Certificates


dataset = xdr_data
| filter event_type = ENUM.FILE
| filter event_sub_type in (ENUM.FILE_OPEN, ENUM.FILE_READ, ENUM.FILE_DIR_READ)
| filter action_file_path ~= "(?i)CertLog"
    or action_file_path ~= "(?i)System32\\CertLog"
| filter actor_process_image_name not in ("certsvc.exe", "CertSvc.exe")
| alter is_remote_smb = if(actor_process_image_name = "System"
    or actor_process_image_name = "system"
    or actor_process_image_name = "ntoskrnl.exe", "YES", "NO")
| alter target_file_type = if(
    action_file_path ~= "(?i)\.edb$", "CA Database - CRITICAL",
    if(action_file_path ~= "(?i)\.log$", "Transaction Log",
    if(action_file_path ~= "(?i)\.pat$", "Patch File",
    if(action_file_path ~= "(?i)\.chk$", "Checkpoint File", "Other"))))
| alter severity = if(action_file_path ~= "(?i)\.edb$" and is_remote_smb = "YES",
    "CRITICAL - Remote CA DB Access", "Review")
| fields _time, agent_hostname, os_actor_primary_username, severity, is_remote_smb, target_file_type, actor_process_image_name, actor_process_image_path, action_file_path, action_file_name, event_sub_type
