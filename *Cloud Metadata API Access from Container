// Cloud Metadata API Access from Container
// Detects outbound connections to cloud instance metadata endpoints from inside a container. Covers AWS/GCP/Azure (169.254.169.254), Alibaba Cloud (100.100.100.200), and AWS ECS task metadata (169.254.170.2).
// MITRE: T1552.005 - Unsecured Credentials: Cloud Instance Metadata API


dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter event_sub_type = ENUM.NETWORK_STREAM_CONNECT
| filter actor_process_container_id != null
| filter action_remote_ip in ("169.254.169.254", "100.100.100.200", "169.254.170.2")
| alter container_info_str = to_string(actor_container_info)
| alter
    container_name = json_extract_scalar(container_info_str, "$.name"),
    container_image = json_extract_scalar(container_info_str, "$.image_name"),
    pod_name = json_extract_scalar(container_info_str, "$.pod_name"),
    pod_namespace = json_extract_scalar(container_info_str, "$.pod_namespace"),
    is_privileged = json_extract_scalar(container_info_str, "$.privileged")
| alter is_shell_caller = if(
    actor_process_image_name in ("sh", "bash", "ash", "dash", "zsh", "curl", "wget", "python", "python3"),
    "YES - Shell/Download Tool", "NO")
| alter metadata_target = if(
    action_remote_ip = "169.254.169.254", "AWS/GCP/Azure IMDS",
    if(action_remote_ip = "100.100.100.200", "Alibaba Cloud Metadata",
    if(action_remote_ip = "169.254.170.2", "AWS ECS task metadata", Other)))
| alter severity = if(
    is_shell_caller = "YES - Shell/Download Tool", "HIGH - Shell Accessing Metadata",
    "MEDIUM - Application Metadata Access")
| filter action_process_image_command_line != null
| filter pod_name != null
| fields _time, severity, metadata_target, agent_hostname, pod_namespace, pod_name, container_name, container_image, is_privileged, actor_process_image_name, action_process_image_command_line, action_remote_ip, action_remote_port, is_shell_caller
| sort desc _time
