// High-Entropy Subdomain AAAA Queries
// Detects DNS queries with unusually long, high-entropy subdomains characteristic of DNS tunneling. HOLLOWGRAPH uses AAAA (IPv6) queries to an attacker-controlled domain to refresh its Entra ID credentials, encoding data in subdomain labels. The pattern is {random}.{taskID}.{fieldIndex}.{offset}.q.{c2domain}.
// Reference https://www.group-ib.com/blog/hollowgraph-microsoft-365/
// MITRE T1071.004 - Application Layer Protocol: DNS, T1572 - Protocol Tunneling


dataset = xdr_data
| alter query_length = array_length(split(dns_query_name, "."))
| alter label_count  = array_length(split(dns_query_name, "."))
| filter event_type in (ENUM.NETWORK, ENUM.STORY)
| filter dns_query_name != null
| filter query_length >= 60
| filter label_count >= 5
| filter dns_query_name ~= "^[a-zA-Z0-9]{8,}\."
| filter dns_query_name not contains "amazonaws.com"
    and dns_query_name not contains "cloudfront.net"
    and dns_query_name not contains "azurewebsites.net"
    and dns_query_name not contains "googleapis.com"
    and dns_query_name not contains "akamaiedge.net"
    and dns_query_name not contains "microsoftonline.com"
    and dns_query_name not contains "azure-dns.com"
    and dns_query_name not contains "windows.net"
| fields _time, agent_hostname, os_actor_primary_username, actor_process_image_name, dns_query_name, query_length, label_count
| sort desc query_length
