// PKINIT Certificate Authentication via Weak Certificate related to Shadow Credentials & AD CS abuse
// Surfaces all successful Kerberos PKINIT authentications (Event 4768, PreAuthType 16) issued by on-premises certificate authorities, excluding Entra ID / WHfB cloud-issued certificates. Use for hunting anomalous PKINIT activity related Shadow Credentials & AD CS abuse.
// MITRE T1649 - Steal or Forge Authentication Certificates, T1558 - Steal or Forge Kerberos Tickets


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id = 4768
| fields action_evtlog_data_fields as aedf, agent_hostname
| filter aedf != null
| alter
    CertIssuerName = aedf -> CertIssuerName,
    CertSerialNumber = aedf -> CertSerialNumber,
    TargetUserName = aedf -> TargetUserName,
    TargetSid = aedf -> TargetSid,
    SourceIP = aedf -> IpAddress,
    AuthStatus = aedf -> Status,
    PreAuthType = aedf -> PreAuthType,
    TicketEncryptionType = aedf -> TicketEncryptionType
| filter AuthStatus = "0x0"
| filter agent_hostname = "REPLACE"
| filter CertIssuerName not contains "login.windows.net"
| filter PreAuthType = "16"
| filter TicketEncryptionType = "0x12"
| fields _time, agent_hostname, TargetUserName, TargetSid, SourceIP, CertIssuerName, CertSerialNumber, PreAuthType, TicketEncryptionType
