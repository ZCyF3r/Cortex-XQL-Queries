// PKINIT Certificate Authentication via On-Prem CA
// Surfaces all successful Kerberos PKINIT authentications (Event 4768, PreAuthType 16) issued by on-premises certificate authorities, excluding Entra ID / WHfB cloud-issued certificates.
// MITRE: T1649 - Steal or Forge Authentication Certificates, T1558 - Steal or Forge Kerberos Tickets


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id = 4768
| fields action_evtlog_data_fields as aedf, agent_hostname
| filter aedf != null
| alter aedf_str = to_string(aedf)
| alter
    CertIssuerName = arrayindex(regextract(aedf_str, "\"(?i)CertIssuerName\":\s*\"([^\"]+)\""), 0),
    CertSerialNumber = arrayindex(regextract(aedf_str, "\"(?i)CertSerialNumber\":\s*\"([^\"]+)\""), 0),
    TargetUserName = arrayindex(regextract(aedf_str, "\"(?i)TargetUserName\":\s*\"([^\"]+)\""), 0),
    TargetSid = arrayindex(regextract(aedf_str, "\"(?i)TargetSid\":\s*\"([^\"]+)\""), 0),
    SourceIP = arrayindex(regextract(aedf_str, "\"(?i)IpAddress\":\s*\"([^\"]+)\""), 0),
    AuthStatus = arrayindex(regextract(aedf_str, "\"(?i)Status\":\s*\"([^\"]+)\""), 0),
    PreAuthType = arrayindex(regextract(aedf_str, "\"(?i)PreAuthType\":\s*\"([^\"]+)\""), 0),
    TicketEncryptionType = arrayindex(regextract(aedf_str, "\"(?i)TicketEncryptionType\":\s*\"([^\"]+)\""), 0)
| filter AuthStatus ~= "0x0"
| filter agent_hostname = "REPLACE"
| filter CertIssuerName not contains "login.windows.net"
| filter PreAuthType ~= "16"
| filter TicketEncryptionType ~= "0x12"
| fields _time, agent_hostname, TargetUserName, TargetSid, SourceIP, CertIssuerName, CertSerialNumber, PreAuthType, TicketEncryptionType
| sort desc _time
