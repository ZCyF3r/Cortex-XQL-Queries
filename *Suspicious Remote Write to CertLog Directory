// Suspicious Remote Write to CertLog Directory
// Detects file writes to the CA's CertLog directory (C:\Windows\System32\CertLog\) by processes other than certsvc.exe.
// The CertLog directory contains the CA database (.edb), transaction logs (.log), and checkpoint files.
// Any non-certsvc write to this directory indicates CA database tampering, log manipulation, or anti-forensics — especially if the source is a non-CA host.
// MITRE: T1070 - Indicator Removal, T1565 - Data Manipulation


dataset = xdr_data
| filter event_type = ENUM.FILE
| filter event_sub_type in (ENUM.FILE_WRITE, ENUM.FILE_CREATE_NEW, ENUM.FILE_OPEN)
| filter action_file_path ~= "(?i)CertLog"
    or action_file_path ~= "(?i)System32\\CertLog"
| filter actor_process_image_name not in ("certsvc.exe", "CertSvc.exe")
| filter causality_actor_type in(ENUM.REMOTE_FILE_SMB, ENUM.REMOTE_NAMED_PIPE, ENUM.REMOTE_TCP)
| alter target_file_type = if(
    action_file_path ~= "(?i)\.edb$", "CA Database",
    if(action_file_path ~= "(?i)\.log$", "Transaction Log",
    if(action_file_path ~= "(?i)\.pat$", "Patch File",
    if(action_file_path ~= "(?i)\.chk$", "Checkpoint File", "Other"))))
| fields _time, agent_hostname, os_actor_primary_username, actor_remote_ip, actor_remote_pipe_name, target_file_type, actor_rpc_interface_uuid, actor_rpc_username, actor_rpc_protocol, action_file_path, action_file_name, event_sub_type
