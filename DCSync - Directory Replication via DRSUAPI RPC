// DCSync - Directory Replication via DRSUAPI RPC
// Detects DsGetNCChanges (opnum 3) on the DRSUAPI interface. DCSync uses this function to replicate AD password hashes.
// MITRE: T1003.006 - OS Credential Dumping: DCSync


dataset = xdr_data
| alter call_fields_str = to_string(action_rpc_func_str_call_fields)
| filter event_type = ENUM.RPC_CALL
| filter action_rpc_interface_uuid = "{E3514235-4B06-11D1-AB04-00C04FC2DCD2}"
| filter action_rpc_func_opnum = 3
| filter causality_actor_type in(ENUM.REMOTE_FILE_SMB, ENUM.REMOTE_HTTP, ENUM.REMOTE_NAMED_PIPE, ENUM.REMOTE_TCP)
| fields _time, agent_hostname, os_actor_primary_username, action_rpc_interface_name, action_rpc_interface_uuid, event_rpc_interface_uuid, event_rpc_func_opnum,action_rpc_func_opnum, action_rpc_func_name, call_fields_str, action_rpc_username, actor_remote_ip, causality_actor_type
