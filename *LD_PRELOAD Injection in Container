// LD_PRELOAD Injection in Container
// Detects LD_PRELOAD in process command lines or container environment variables. Attackers use it to hijack function calls, bypass security controls, or hide processes.
// MITRE: T1574.006 - Hijack Execution Flow: Dynamic Linker Hijacking


dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_container_id != null
| alter container_info_str = to_string(actor_container_info)
| alter
    container_name = json_extract_scalar(container_info_str, "$.name"),
    container_image = json_extract_scalar(container_info_str, "$.image_name"),
    pod_name = json_extract_scalar(container_info_str, "$.pod_name"),
    pod_namespace = json_extract_scalar(container_info_str, "$.pod_namespace"),
    is_privileged = json_extract_scalar(container_info_str, "$.privileged"),
    container_env = to_string(json_extract(container_info_str, "$.env"))
| filter
    action_process_image_command_line ~= "(?i)(LD_PRELOAD)"
    or container_env ~= "(?i)(LD_PRELOAD)"
    or (action_process_image_name in ("gcc", "g++", "cc", "clang", "clang++")
        and action_process_image_command_line ~= "(?i)(-shared)"
        and action_process_image_command_line ~= "(?i)(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/)")
| alter detection_type = if(
    action_process_image_name in ("gcc", "g++", "cc", "clang", "clang++"), "Shared Object Compilation",
    if(action_process_image_command_line ~= "(?i)(LD_PRELOAD)", "LD_PRELOAD in Command Line",
    "LD_PRELOAD in Container Env"))
| alter is_suspicious_path = if(
    action_process_image_command_line ~= "(?i)(LD_PRELOAD\s*=\s*\S*(\/tmp\/|\/dev\/shm\/|\/var\/tmp\/))",
    "YES - Writable Path", "NO")
| alter is_known_apm = if(
    action_process_image_command_line ~= "(?i)(\/opt\/datadog|\/opt\/dynatrace|dd-java-agent|newrelic|elastic-apm)"
    or container_env ~= "(?i)(\/opt\/datadog|\/opt\/dynatrace|dd-java-agent|newrelic|elastic-apm)",
    "YES - Known APM", "NO")
| alter severity = if(
    detection_type = "Shared Object Compilation", "CRITICAL - .c to .so in Writable Path",
    if(is_suspicious_path = "YES - Writable Path", "HIGH - LD_PRELOAD from Writable Path",
    if(is_known_apm = "YES - Known APM", "LOW - Known APM Agent",
    "MEDIUM - LD_PRELOAD Detected")))
| fields _time, severity, detection_type, agent_hostname, pod_namespace, pod_name, container_name, container_image, is_privileged, actor_process_image_name, action_process_image_name, action_process_image_command_line, container_env, is_suspicious_path, is_known_apm
| sort desc _time
