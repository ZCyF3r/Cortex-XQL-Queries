// ConnectWise Supply-Chain - Post-Compromise M365 Activity
// Detects any M365 activity initiated by compromised ConnectWise service principals.
// Reference: https://www.bleepingcomputer.com/news/security/hackers-breach-microsoft-365-tenants-via-connectwise-supply-chain-attack/
// MITRE: T1114.002 - Email Collection: Remote Email Collection, T1213.002 - Data from Information Repositories: Sharepoint, T1199 - Trusted Relationship


dataset = saas_audit_logs
| filter identity_invoked_by_uuid in (
    "506e08f9-6e9a-4da4-942b-a099a03644ae",
    "24205314-2b89-4e07-a2a4-579e898a5640",
    "2399d300-6fca-4e6a-a686-399fefe75b83",
    "b78f6a77-d4e5-46fb-87e5-d1648bd02519",
    "0de14c77-b9b0-4137-9360-34878a929827",
    "412dcf96-176d-4b3a-a1b0-4981ad66971e",
    "b2b55f5b-7758-4719-8d8f-88ae172e6bdb")
| alter activity_category = if(
    service_type = "Exchange", if(
        operation_name_orig ~= "(?i)(MailItemsAccessed|MessageBind)", "EMAIL READ",
        if(operation_name_orig ~= "(?i)(SearchCommand|SearchStarted|SearchCreated)", "EMAIL SEARCH",
        if(operation_name_orig ~= "(?i)(New-InboxRule|Set-InboxRule|UpdateInboxRules)", "INBOX RULE",
        if(operation_name_orig ~= "(?i)(Set-Mailbox|Forward)", "MAIL FORWARDING",
        if(operation_name_orig ~= "(?i)(Send|SendAs|SendOnBehalf)", "SENT EMAIL",
        "EXCHANGE OTHER"))))),
    if(service_type ~= "(?i)sharepoint", if(
        operation_name_orig ~= "(?i)(FileAccessed|FileDownloaded|FileCheckedOut)", "FILE ACCESS",
        if(operation_name_orig ~= "(?i)(SharingSet|AddedToSecureLink|AnonymousLink)", "FILE SHARED",
        "SHAREPOINT OTHER")),
    service_type))
| fields _time, activity_category, identity_name, identity_invoked_by_uuid, service_type, operation_name_orig, operation_status, referenced_resource_name, caller_ip, caller_ip_geolocation, caller_ip_asn, caller_ip_asn_org, user_agent
| sort desc _time
