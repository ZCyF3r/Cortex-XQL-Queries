// Microsoft Graph API Reconnaissance for Financial Personnel (Payroll Pirates)
// Detects Graph API enumeration of tenant users filtered by payroll, HR, finance, and administrative attributes. Storm-2755 uses axios and queries graph.microsoft.com/v1.0/users targeting financial personnel before collecting their mailbox data. Also flags bulk user enumeration via $top=999. Results aggregated by source IP/ASN to surface coordinated reconnaissance across multiple identities.
// Reference: https://arcticwolf.com/resources/blog/payroll-pirates-strange-new-tides-in-business-email-compromise/
// MITRE T1087.003 - Account Discovery: Email Account, T1114 - Email Collection


dataset = cloud_audit_logs 
| alter finance_recon = if(operation_name_orig ~= "(?i)/users"
    and operation_name_orig ~= "(?i)(payroll|finance|hr|human.resources|accounting|benefits|controller|treasury|compensation|accounts.payable)", "YES", "NO")
| alter bulk_enum = if(operation_name_orig ~= "(?i)/users.*\\$top=999", "YES", "NO")
| alter is_axios = if(user_agent ~= "(?i)(axios)", "YES", "NO")
| filter log_name = "microsoft_graph_activity_logs"
| filter operation_name = ENUM.Get
| filter finance_recon = "YES" or bulk_enum = "YES" or is_axios = "YES"
| comp
    count() as total_requests,
    count_distinct(operation_name_orig) as queries_made,
    count_distinct(identity_name) as distinct_identities,
    values(identity_name) as targeted_users,
    values(finance_recon) as is_finance_recon,
    values(bulk_enum) as is_bulk_enum,
    values(is_axios) as is_axios,
    values(user_agent) as user_agents,
    values(caller_ip_geolocation) as geolocations,
    min(_time) as first_seen,
    max(_time) as last_seen
    by caller_ip, caller_ip_asn, caller_ip_asn_org
| filter caller_ip_asn_org !~= "(?i)(microsoft|amazon|google|zscaler)"
| sort desc total_requests
