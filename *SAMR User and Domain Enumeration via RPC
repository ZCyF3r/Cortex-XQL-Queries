// SAMR User and Domain Enumeration via RPC
// Detects SamrEnumerateUsersInDomain (opnum 13), SamrLookupNamesInDomain (opnum 17), and SamrQueryInformationUser (opnum 36) on the SAMR interface. Used by secretsdump, BloodHound, NetExec, and other enumeration tools to list domain users and retrieve account attributes. High volume from a single source indicates automated enumeration.
// MITRE: T1087.002 - Account Discovery: Domain Account


dataset = xdr_data
| filter event_type = ENUM.RPC_CALL
| filter action_rpc_interface_uuid = "{12345778-1234-ABCD-EF00-0123456789AC}"
| filter action_rpc_func_opnum in (13, 17, 36)
| alter call_fields_str = to_string(action_rpc_func_str_call_fields)
| fields _time, agent_hostname, os_actor_primary_username, actor_process_image_name, actor_process_image_path, actor_process_command_line, actor_process_os_pid, actor_process_image_sha256, actor_process_signature_status, action_rpc_interface_name, action_rpc_interface_uuid, event_rpc_interface_uuid, event_rpc_func_opnum, rpc_function, action_rpc_func_opnum, action_rpc_func_name, call_fields_str, action_rpc_username, actor_remote_ip, causality_actor_type, lpServiceName, lpDisplayName, lpBinarypathName
