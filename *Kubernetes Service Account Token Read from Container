// Kubernetes Service Account Token Read from Container
// Detects file reads of mounted service account tokens. Covers the default K8s path, projected volume custom paths, EKS IRSA path, and AKS Workload Identity path.
// MITRE: T1528 - Steal Application Access Token


dataset = xdr_data
| filter event_type = ENUM.FILE
| filter event_sub_type = ENUM.FILE_OPEN
| filter actor_process_container_id != null
| filter action_file_path ~= "(?i)(\/var\/run\/secrets\/kubernetes\.io|\/run\/secrets\/kubernetes\.io|serviceaccount\/token|serviceaccount\/ca\.crt|\/var\/run\/secrets\/tokens\/|\/var\/run\/secrets\/eks\.amazonaws\.com\/serviceaccount|\/var\/run\/secrets\/azure\/tokens\/)"
| filter actor_process_image_name !~= "(?i)(filebeat|aws|kube|amazon|helm|patroni)"
| alter container_info_str = to_string(actor_container_info)
| alter
    container_name = json_extract_scalar(container_info_str, "$.name"),
    container_image = json_extract_scalar(container_info_str, "$.image_name"),
    pod_name = json_extract_scalar(container_info_str, "$.pod_name"),
    pod_namespace = json_extract_scalar(container_info_str, "$.pod_namespace"),
    is_privileged = json_extract_scalar(container_info_str, "$.privileged")
| alter is_shell_reader = if(
    actor_process_image_name in ("sh", "bash", "ash", "dash", "zsh", "curl", "wget",
        "python", "python3", "perl", "ruby", "node", "php"),
    "YES - Suspicious Process", "NO")
| alter token_type = if(
    action_file_path ~= "(?i)eks\.amazonaws\.com", "EKS IRSA Token",
    if(action_file_path ~= "(?i)\/secrets\/azure\/", "AKS Workload Identity Token",
    if(action_file_path ~= "(?i)\/secrets\/tokens\/", "Projected Volume Token",
    "Default SA Token")))
| alter severity = if(
    is_shell_reader = "YES - Suspicious Process", "HIGH - Shell Reading SA Token",
    "MEDIUM - SA Token Read")
| filter pod_name != null
| fields _time, severity, token_type, agent_hostname, pod_namespace, pod_name, container_name, container_image, is_privileged, actor_process_image_name, action_file_path, action_process_image_command_line, is_shell_reader
| sort desc _time
