// Kerberoasting Activity (RC4 Service Ticket)
// Detects requests for multiple Kerberos service tickets (4769) using weak RC4 encryption (0x17) within a short window. Attackers request service tickets for accounts with SPNs then crack them offline to recover service account passwords. Multiple distinct SPNs from one user/IP indicates automated Kerberoasting. Excludes krbtgt and machine accounts.
// MITRE T1558.003 - Kerberoasting, T1558 - Steal or Forge Kerberos Tickets


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id = 4769
| fields action_evtlog_data_fields as aedf, agent_hostname
| filter aedf != null
| alter TicketEncryptionType = aedf->TicketEncryptionType
| alter Status = aedf->Status
| alter ServiceName = aedf->ServiceName
| alter TargetUserName = aedf->TargetUserName
| alter IpAddress = aedf->IpAddress
| filter TicketEncryptionType in ("0x17", "23")
| filter Status = "0x0"
| filter TargetUserName not contains "krbtgt"
| filter TargetUserName not contains "$"
| bin _time span = 10m
| comp count_distinct(ServiceName) as Unique_SPNs_Requested, values(ServiceName) as Targeted_Services, values(agent_hostname) as DC_Hostnames by TargetUserName, IpAddress, _time
| filter Unique_SPNs_Requested >= 4
| sort desc Unique_SPNs_Requested
