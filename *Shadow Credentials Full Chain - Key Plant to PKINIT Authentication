// Title       : Shadow Credentials Full Chain - Key Plant to PKINIT Authentication
// Description : Correlates an msDS-KeyCredentialLink addition (Event 5136) with a
//               subsequent successful PKINIT authentication (Event 4768) on the same
//               account within 24 hours. This is the complete Shadow Credentials
//               attack chain: attacker plants a controlled public key on the target
//               object, then authenticates as that account using the corresponding
//               certificate via PKINIT. A match on this query is near-certain
//               compromise — legitimate WHfB enrollment does not produce the same
//               pattern of a 5136 from one principal followed by a 4768 from a
//               different source IP shortly after.
// MITRE       : T1556.004 - Modify Authentication Process: Network Device Authentication
//               T1649 - Steal or Forge Authentication Certificates
//               T1558 - Steal or Forge Kerberos Tickets


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id = 5136
| fields action_evtlog_data_fields as aedf, agent_hostname, _time
| filter aedf != null
| alter
    PlantSubject       = aedf -> SubjectUserName,
    PlantSubjectDomain = aedf -> SubjectDomainName,
    ObjectDN           = aedf -> ObjectDN,
    ObjectClass        = aedf -> ObjectClass,
    AttributeLDAPDisplayName = aedf -> AttributeLDAPDisplayName,
    DSType             = aedf -> DSType
| filter AttributeLDAPDisplayName = "msDS-KeyCredentialLink"
| filter DSType = "%%14676"
| alter
    plant_dc         = agent_hostname,
    plant_time       = _time,
    TargetAccountRaw = arrayindex(regextract(ObjectDN, "(?i)^CN=([^,]+)"), 0)
| alter TargetAccountKey = lowercase(TargetAccountRaw)
| join type=inner (
    dataset = xdr_data
    | filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id = 4768
    | fields action_evtlog_data_fields, agent_hostname, _time
    | filter action_evtlog_data_fields != null
    | alter JoinKey = lowercase(action_evtlog_data_fields -> TargetUserName)
) as pkinit pkinit.JoinKey = TargetAccountKey
// Extract everything from the native joined field AFTER the join
| alter
    auth_time            = pkinit._time,
    auth_dc              = pkinit.agent_hostname,
    AuthSourceIP         = pkinit.action_evtlog_data_fields -> IpAddress,
    AuthUser             = pkinit.action_evtlog_data_fields -> TargetUserName,
    AuthSid              = pkinit.action_evtlog_data_fields -> TargetSid,
    AuthStatus           = pkinit.action_evtlog_data_fields -> Status,
    AuthPreAuthType      = pkinit.action_evtlog_data_fields -> PreAuthType,
    AuthCertIssuer       = pkinit.action_evtlog_data_fields -> CertIssuerName,
    AuthCertSerial       = pkinit.action_evtlog_data_fields -> CertSerialNumber,
    AuthTicketEncryption = pkinit.action_evtlog_data_fields -> TicketEncryptionType
// Now filter using standalone field names
| filter AuthStatus = "0x0"
| filter AuthPreAuthType = "16"
| filter AuthCertIssuer not contains "login.windows.net"
| filter auth_time >= plant_time
