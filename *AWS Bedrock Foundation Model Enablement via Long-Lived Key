// AWS Bedrock Foundation Model Enablement via Long-Lived Key
// Detects foundation model access enablement APIs called by IAM users with long-lived access keys (AKIA). 
// These console style APIs are used to subscribe to models that aren't yet available in the account. An AKIA key calling PutUseCaseForModelAccess or CreateFoundationModelAgreement is a strong compromise indicator, legitimate enablement goes through the console with federated credentials.
// Reference: https://www.abstract.security/blog/detecting-aws-bedrock-abuse-from-llmjacking-to-the-hidden-attack-vectors
// MITRE: T1496 - Resource Hijacking


dataset = amazon_aws_raw
| filter eventSource = "bedrock.amazonaws.com"
| filter eventName in (
    "PutUseCaseForModelAccess",
    "CreateFoundationModelAgreement",
    "GetFoundationModelAvailability")
| alter
    principal_arn = userIdentity -> arn,
    access_key = userIdentity -> accessKeyId,
    user_type = userIdentity -> type
| alter is_long_lived_key = if(access_key ~= "^AKIA", "YES", "NO")
| fields _time, eventName, principal_arn, access_key, is_long_lived_key, user_type, sourceIPAddress, awsRegion, userAgent, requestParameters, errorCode
| sort desc _time
