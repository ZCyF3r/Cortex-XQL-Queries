// Choas Ransomware - RDP Enablement via msconfig for Lateral Movement
// Detects msconfig.exe execution or registry modifications enabling Remote Desktop services.
// Reference https://www.sophos.com/en-us/blog/chaos-in-teams-vishing
// MITRE T1021.001 - Remote Services: Remote Desktop Protocol, T1112 - Modify Registry


dataset = xdr_data
| filter
    (event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
        and action_process_image_name = "msconfig.exe")
    or
    (event_type = ENUM.REGISTRY
        and action_registry_key_name ~= "(?i)Terminal Server"
        and action_registry_value_name = "fDenyTSConnections"
        and action_registry_data = "0")
    or
    (event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
        and action_process_image_command_line ~= "(?i)(fDenyTSConnections.*0|TermService.*start|netsh.*firewall.*remote desktop)")
| alter detection_type = if(
    action_process_image_name = "msconfig.exe", "msconfig Execution",
    if(event_type = ENUM.REGISTRY, "RDP Registry Enable",
    "RDP Command Line Enable"))
| fields _time, agent_hostname, os_actor_primary_username, detection_type, actor_process_image_name, action_process_image_name, action_process_image_command_line, action_registry_key_name, action_registry_value_name, action_registry_data
