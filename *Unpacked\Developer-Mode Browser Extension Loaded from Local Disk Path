dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("chrome.exe", "msedge.exe", "brave.exe", "chromium.exe") or action_process_image_name in ("chrome.exe", "msedge.exe", "brave.exe", "chromium.exe")
| filter action_process_command_line contains "--load-extension" or action_process_command_line contains "--disable-extensions-except"
| alter LoadedExtensionPath = coalesce(regextract(action_process_command_line, "--load-extension=([^ ]+)"), regextract(action_process_command_line, "--disable-extensions-except=([^ ]+)"))
| fields _time, agent_hostname, os_actor_primary_username, actor_process_image_name, action_process_image_name, action_process_command_line, LoadedExtensionPath
