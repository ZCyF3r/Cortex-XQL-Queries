// Google Workspace OAuth App Authorization Spike\Bulk Token Grants
// Detects a user authorizing an unusual number of OAuth apps in a short window. Automated consent phishing toolkits or compromised accounts mass-granting app access produce a burst of authorize events. Legitimate users rarely authorize more than a few apps per day.
// MITRE T1528 - Steal Application Access Token


dataset = google_workspace_token_raw 
| alter events_str = to_string(events)
| alter event_name = json_extract_scalar(events_str, "$[0].name")
| alter
    client_id = arrayindex(regextract(events_str, "\"name\":\s*\"client_id\",\s*\"value\":\s*\"([^\"]+)\""), 0),
    app_name = arrayindex(regextract(events_str, "\"name\":\s*\"app_name\",\s*\"value\":\s*\"([^\"]+)\""), 0),
    actor_email = json_extract_scalar(actor, "$.email")
| filter event_name = "authorize"
| comp
    count() as total_grants,
    count_distinct(app_name) as distinct_apps,
    values(app_name) as app_authorized,
    values(ipAddress) as source_ips,
    min(_time) as first_seen,
    max(_time) as last_seen
    by actor_email
| filter total_grants >= 5
| sort desc total_grants
