// AD CS ESC1\ESC6 - Certificate Issued with SAN Mismatch
// Detects certificates issued where the Subject Alternative Name (SAN) contains a UPN that does not match the requester. ESC1 exploits templates with CT_FLAG_ENROLLEE_SUPPLIES_SUBJECT enabled, allowing any enrollee to specify an arbitrary SAN (e.g. Domain Admin UPN). 
// ESC6 achieves the same result via the EDITF_ATTRIBUTESUBJECTALTNAME2 CA flag, which allows SAN specification on ANY template regardless of template config. Requester ≠ SAN is the highest-fidelity AD CS abuse signal.
// MITRE: T1649 - Steal or Forge Authentication Certificates


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG
| filter action_evtlog_event_id = 4887
| fields action_evtlog_data_fields as aedf, agent_hostname, _time
| filter aedf != null
| alter aedf_str = to_string(aedf)
| alter
    Requester = arrayindex(regextract(aedf_str, "\"(?i)requester\":\s*\"([^\"]+)\""), 0),
    SAN_field = arrayindex(regextract(aedf_str, "\"(?i)subjectalternativename\":\s*\"([^\"]+)\""), 0),
    Attributes = arrayindex(regextract(aedf_str, "\"(?i)attributes\":\s*\"([^\"]+)\""), 0),
    CertSubject = arrayindex(regextract(aedf_str, "\"(?i)subject\":\s*\"([^\"]+)\""), 0),
    Template = arrayindex(regextract(aedf_str, "\"(?i)certificatetemplate\":\s*\"([^\"]+)\""), 0),
    SerialNumber = arrayindex(regextract(aedf_str, "\"(?i)serialnumber\":\s*\"([^\"]+)\""), 0),
    RequestID = arrayindex(regextract(aedf_str, "\"(?i)requestid\":\s*\"([^\"]+)\""), 0),
    AuthService = arrayindex(regextract(aedf_str, "\"(?i)authenticationservice\":\s*\"([^\"]+)\""), 0),
    AuthLevel = arrayindex(regextract(aedf_str, "\"(?i)authenticationlevel\":\s*\"([^\"]+)\""), 0),
    Disposition = arrayindex(regextract(aedf_str, "\"(?i)disposition\":\s*\"([^\"]+)\""), 0)
| alter san_upn_1 = arrayindex(regextract(SAN_field, "(?i)Principal Name=([^\r\n\\\\]+)"), 0)
| alter san_upn_2 = arrayindex(regextract(Attributes, "(?i)SAN:upn=([^\r\n\\\\]+)"), 0)
| alter san_upn = coalesce(san_upn_1, san_upn_2)
| alter requester_user = arrayindex(regextract(Requester, "\\\\([^\\\\]+)$"), 0)
| alter san_upn_lower = lowercase(san_upn)
| alter requester_lower = lowercase(requester_user)
| filter san_upn != null
| filter san_upn_lower not contains requester_lower
    and requester_lower not contains san_upn_lower
| alter is_ntlm = if(AuthService ~= "(?i)NTLM", "YES", "NO")
| fields _time, agent_hostname, Requester, requester_user, san_upn, CertSubject, Template, SerialNumber, RequestID, Disposition, AuthService, AuthLevel, is_ntlm
