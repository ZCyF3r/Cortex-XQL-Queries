// Unexpected Binary or Payload Download Inside Container
// Detects runtime downloads in containers.
// MITRE: T1105 - Ingress Tool Transfer


dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_container_id != null
| filter
    (action_process_image_name in ("curl", "wget", "fetch")
        and action_process_image_command_line ~= "(http|ftp)")
    or (action_process_image_name = "busybox"
        and action_process_image_command_line ~= "(?i)(wget|curl|nc)")
    or (action_process_image_name in ("python", "python3", "perl", "ruby")
        and action_process_image_command_line ~= "(?i)(urllib|requests\.get|wget|urlopen|Net::HTTP|open-uri)")
    or (action_process_image_name in ("pip", "pip3")
    or (action_process_image_name in ("npm", "npx")
        and action_process_image_command_line ~= "(?i)(install|exec)")
    or (action_process_image_name = "gem"
        and action_process_image_command_line ~= "(?i)(install)")
    or action_process_image_command_line ~= "(?i)(\/dev\/tcp\/\d)"
    or action_process_image_command_line ~= "(?i)(base64\s+-d\s.*\|\s*(sh|bash|chmod))"
    or action_process_image_name in ("scp", "sftp", "lwp-download")
| alter container_info_str = to_string(actor_container_info)
| alter
    container_name = json_extract_scalar(container_info_str, "$.name"),
    container_image = json_extract_scalar(container_info_str, "$.image_name"),
    pod_name = json_extract_scalar(container_info_str, "$.pod_name"),
    pod_namespace = json_extract_scalar(container_info_str, "$.pod_namespace"),
    is_privileged = json_extract_scalar(container_info_str, "$.privileged"),
    container_command = json_extract_scalar(container_info_str, "$.other.command"),
    container_mounts = to_string(json_extract(container_info_str, "$.other.mounts"))
| alter download_method = if(
    action_process_image_name in ("pip", "pip3", "npm", "npx", "gem"), "Package Manager Install",
    if(action_process_image_name in ("scp", "sftp", "lwp-download"), "File Transfer Tool",
    if(action_process_image_command_line ~= "(?i)base64", "Base64 Decode Pipeline",
    if(action_process_image_command_line ~= "(?i)\/dev\/tcp", "Bash /dev/tcp",
    if(action_process_image_name = "busybox", "Busybox Download",
    "HTTP Download Tool")))))
| fields _time, download_method, agent_hostname, pod_namespace, pod_name, container_name, container_image, is_privileged, actor_process_image_name, action_process_image_name, action_process_image_command_line, container_command, container_mounts
| sort desc _time
