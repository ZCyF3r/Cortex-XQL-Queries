// Kubernetes Container Outbound Network Connections
// All outbound network connections initiated from inside containers.
// MITRE : T1071 - Application Layer Protocol


dataset = xdr_data
| filter event_type = ENUM.NETWORK
| filter event_sub_type = ENUM.NETWORK_STREAM_CONNECT
| filter actor_process_container_id != null
| alter container_info_str = to_string(actor_container_info)
| alter
    container_name = json_extract_scalar(container_info_str, "$.name"),
    container_image = json_extract_scalar(container_info_str, "$.image_name"),
    pod_name = json_extract_scalar(container_info_str, "$.pod_name"),
    pod_namespace = json_extract_scalar(container_info_str, "$.pod_namespace"),
    is_privileged = json_extract_scalar(container_info_str, "$.privileged")
| fields _time, agent_hostname, pod_namespace, pod_name, container_name, container_image, is_privileged, actor_process_image_name, action_remote_ip, action_remote_port, action_local_ip, action_local_port
| sort desc _time
