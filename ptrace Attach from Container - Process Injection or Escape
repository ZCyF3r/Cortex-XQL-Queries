// ptrace Attach from Container - Process Injection or Escape
// Detects TRACE_ATTACH events from within containers. ptrace is used to inject code into other processes, escape container boundaries by attaching to host processes (with hostPID + CAP_SYS_PTRACE), or dump credentials from process memory.
// MITRE: T1055 - Process Injection, T1611 - Escape to Host


dataset = xdr_data
| filter event_type = ENUM.TRACE and event_sub_type = ENUM.TRACE_ATTACH
| filter actor_process_container_id != null
| alter container_info_str = to_string(actor_container_info)
| alter
    container_name = json_extract_scalar(container_info_str, "$.name"),
    container_image = json_extract_scalar(container_info_str, "$.image_name"),
    pod_name = json_extract_scalar(container_info_str, "$.pod_name"),
    pod_namespace = json_extract_scalar(container_info_str, "$.pod_namespace"),
    is_privileged = json_extract_scalar(container_info_str, "$.privileged"),
    container_command = json_extract_scalar(container_info_str, "$.other.command"),
    container_mounts = to_string(json_extract(container_info_str, "$.other.mounts"))
| filter pod_name != null
| filter actor_process_image_name != null
| filter action_process_image_name != null
| filter pod_namespace not in ("kube-system", "calico-system", "cilium", "tigera-operator",
    "monitoring", "logging", "istio-system", "linkerd", "datadog", "dynatrace", "newrelic")
| filter container_image !~= "(?i)(datadog|dynatrace|newrelic|instana|sysdig|falco|aquasec|twistlock|prismacloud|stackrox)"
| alter severity = if(
    is_privileged = "true", "CRITICAL - ptrace in Privileged Container",
    "HIGH - ptrace Attach from Container")
| fields _time, severity, agent_hostname, pod_namespace, pod_name, container_name, container_image, is_privileged, actor_process_image_name, action_process_image_name, action_process_image_command_line, container_command, container_mounts
| sort desc _time
