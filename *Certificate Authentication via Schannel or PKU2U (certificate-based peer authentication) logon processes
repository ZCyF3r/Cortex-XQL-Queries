// Certificate Authentication via Schannel or PKU2U
// Detects successful logon events using Schannel (TLS client certificate) or PKU2U (certificate-based peer authentication) logon processes. After obtaining a forged certificate via ESC1-ESC8, attackers can authenticate using these paths instead of PKINIT to bypass Kerberos-based detections.
// MITRE: T1649 - Steal or Forge Authentication Certificates, T1078.002 - Valid Accounts: Domain Accounts


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG
| filter action_evtlog_event_id = 4624
| fields action_evtlog_data_fields as aedf, agent_hostname, _time
| filter aedf != null
| alter aedf_str = to_string(aedf)
| alter
    AuthPackage = arrayindex(regextract(aedf_str, "\"(?i)AuthenticationPackageName\":\s*\"([^\"]+)\""), 0),
    LogonType = arrayindex(regextract(aedf_str, "\"(?i)LogonType\":\s*\"([^\"]+)\""), 0),
    TargetUserName = arrayindex(regextract(aedf_str, "\"(?i)TargetUserName\":\s*\"([^\"]+)\""), 0),
    TargetDomainName = arrayindex(regextract(aedf_str, "\"(?i)TargetDomainName\":\s*\"([^\"]+)\""), 0),
    SubjectUserName = arrayindex(regextract(aedf_str, "\"(?i)SubjectUserName\":\s*\"([^\"]+)\""), 0),
    SourceIP = arrayindex(regextract(aedf_str, "\"(?i)IpAddress\":\s*\"([^\"]+)\""), 0),
    WorkstationName = arrayindex(regextract(aedf_str, "\"(?i)WorkstationName\":\s*\"([^\"]+)\""), 0),
    ElevatedToken = arrayindex(regextract(aedf_str, "\"(?i)ElevatedToken\":\s*\"([^\"]+)\""), 0),
    ImpersonationLevel = arrayindex(regextract(aedf_str, "\"(?i)ImpersonationLevel\":\s*\"([^\"]+)\""), 0),
    LogonProcessName = arrayindex(regextract(aedf_str, "\"(?i)LogonProcessName\":\s*\"([^\"]+)\""), 0)
| filter LogonProcessName in ("Schannel", "Pku2uS4U", "Pku2uSsp")
| filter LogonType = "3"
| filter TargetUserName not contains "$"
| alter cert_auth_type = if(
    LogonProcessName = "Schannel", "TLS Client Certificate",
    if(LogonProcessName = "Pku2uS4U", "PKU2U Service-for-User",
    "PKU2U Peer Auth"))
| alter is_admin_target = if(
    TargetUserName ~= "(?i)(admin|adm-|da-|domain.*admin|enterprise.*admin)",
    "YES", "NO")
| alter is_elevated = if(ElevatedToken = "%%1842", "YES", "NO")
| fields _time, agent_hostname, TargetUserName, TargetDomainName, SubjectUserName, SourceIP, WorkstationName, AuthPackage, LogonType, LogonProcessName, cert_auth_type, ElevatedToken, is_elevated, is_admin_target, ImpersonationLevel
| sort desc _time
