// Command Shell or Scripting Interpreter Spawned by Browser Process
// Detects a browser process directly spawning a command shell or scripting interpreter. Malicious browser extensions can invoke native messaging hostsor exploit browser vulnerabilities to execute system commands.
// Add in benign processes to be removed for higher fidelity
// MITRE T1176 - Browser Extensions, T1059 - Command and Scripting Interpreter


dataset = xdr_data
| filter event_type = ENUM.PROCESS and event_sub_type = ENUM.PROCESS_START
| filter actor_process_image_name in ("chrome.exe", "msedge.exe", "brave.exe", "chromium.exe", "firefox.exe")
| filter action_process_image_name in ("cmd.exe", "powershell.exe", "pwsh.exe",
         "wscript.exe", "cscript.exe", "mshta.exe", "python.exe", "node.exe")
| filter action_process_image_command_line not contains "InAppCshExtensionConfigure.exe"
    and action_process_image_command_line not contains "WCChromeNativeMessagingHost.exe"
    and action_process_image_command_line not contains "NMHost.exe"
    and action_process_image_command_line not contains "ietabhelper.exe"
    and action_process_image_command_line not contains "PAD.BrowserNativeMessageHost.exe"
    and action_process_image_command_line not contains "BrowserCore.exe"
| fields _time, agent_hostname, os_actor_primary_username, actor_process_image_name, actor_process_image_path, action_process_image_name, action_process_image_path, action_process_image_command_line, actor_process_command_line
