// Kubernetes API Server Cloud Audit Logs Activity
// Detects cloud audit log events associated with the Kubernetes API server, providing visibility into administrative and operational actions performed within a Kubernetes cluster.


dataset = cloud_audit_logs 
| filter service_type = "Kubernetes"
| filter resource_sub_type_orig ~= "(?i)(kube-apiserver)"
//| filter identity_name = ""
//| filter identity_invoked_by_name = ""
| fields _time, cloud_provider, identity_name, identity_invoked_by_name, identity_invoked_by_type, operation_name, operation_name_orig, operation_status, operation_status_reason_provided, referenced_resource, referenced_resource_name, user_agent, raw_log 
