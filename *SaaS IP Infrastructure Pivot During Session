// SaaS IP Infrastructure Pivot During Session
// Detects a user whose activity shifts from residential/ISP infrastructure to hosted/datacenter infrastructure within the same time window.
// Helix authenticates from residential proxies aligned to victim geography, then pivots to a dedicated hosted IP for automated exfiltration.
// This residential → hosted pivot is a persistent fingerprint across Helix incidents.
// Actor: Helix (related to BlackFile / ShinyHunters)
// MITRE: T1090 - Proxy


dataset = saas_audit_logs
| filter service_type ~= "(?i)(sharepoint|exchange|onedrive)"
| alter
    infrastructure = json_extract_scalar(caller_ip_enrichment, "$.infrastructure"),
    IsVPN = json_extract_scalar(caller_ip_enrichment, "$.tunnels_type")
| alter infra_type = if(
    infrastructure ~= "(?i)(isp|residential|mobile)", "Residential",
    if(infrastructure ~= "(?i)(hosting|datacenter|cloud|server|colocation)", "Hosted",
    "Unknown"))
| comp
    count() as total_events,
    count_distinct(caller_ip) as distinct_ips,
    count_distinct(infra_type) as distinct_infra_types,
    values(infra_type) as infra_types,
    values(caller_ip) as source_ips,
    values(service_type) as services_accessed,
    values(operation_name_orig) as operations,
    min(_time) as first_seen,
    max(_time) as last_seen
  by identity_name
| filter distinct_infra_types >= 2
| filter infra_types contains "Residential" and infra_types contains "Hosted"
| sort desc total_events
