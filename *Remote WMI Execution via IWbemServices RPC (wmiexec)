// Remote WMI Execution via IWbemServices RPC (wmiexec)
// Detects remote WMI method execution through the IWbemServices RPC interface. Impacket wmiexec uses ExecMethod (opnum 24) to call Win32_Process.Create on remote hosts.
// MITRE: T1047 - Windows Management Instrumentation


dataset = xdr_data
| alter call_fields_str = to_string(action_rpc_func_str_call_fields)
| alter WMI_Command = json_extract_scalar(call_fields_str, "$.InParams_CommandLine")
| filter event_type = ENUM.RPC_CALL
| filter action_rpc_interface_uuid = "{9556DC99-828C-11CF-A37E-00AA003240C7}"
| filter causality_actor_type in(ENUM.REMOTE_FILE_SMB, ENUM.REMOTE_HTTP, ENUM.REMOTE_NAMED_PIPE, ENUM.REMOTE_TCP)
| filter action_rpc_func_opnum = 24
| fields _time, agent_hostname, os_actor_primary_username, action_rpc_interface_name, action_rpc_interface_uuid, event_rpc_interface_uuid, event_rpc_func_opnum, action_rpc_func_opnum, action_rpc_func_name, WMI_Command, action_rpc_username, actor_remote_ip, causality_actor_type, call_fields_str
