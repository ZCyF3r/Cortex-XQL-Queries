// Title       : CertiGhost PKINIT Detection - Certificate Identity Mismatch to Non-DC Account
// Description : Detects Kerberos PKINIT authentications (Event 4768) where the certificate-embedded
//               UPN/SID does not match the target account's actual SID, and the target computer
//               account is not a verified Domain Controller in AD inventory. CVE-2026-54121
//               (CertiGhost) allows a low-privileged domain user to poison an AD CS CA's
//               directory-resolution chase fallback, causing it to issue a certificate mapping
//               to a DC identity. The attacker then uses PKINIT to authenticate as the DC
//               for full domain compromise via DCSync.
//               Also covers: Shadow Credentials, AD CS ESC9/ESC10, Certipy, Rubeus.
// CVE         : CVE-2026-54121
// CVSS        : 8.8 High (AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H)
// Reference   : https://www.penligent.ai/hackinglabs/cve-2026-54121/
// MITRE       : T1649 - Steal or Forge Authentication Certificates
//               T1558 - Steal or Forge Kerberos Tickets
//               T1078.002 - Valid Accounts: Domain Accounts

dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG and action_evtlog_event_id = 4768
| fields action_evtlog_data_fields as aedf, agent_hostname
| filter aedf != null
| alter
    CertIssuerName   = aedf -> CertIssuerName,
    CertSerialNumber = aedf -> CertSerialNumber,
    CertificateUPN   = aedf -> AltSecurityIdentityUPN,
    CertificateSID   = aedf -> AltSecurityIdentitySid,
    TargetUserName   = aedf -> TargetUserName,
    TargetSid        = aedf -> TargetSid,
    SourceIP         = aedf -> IpAddress,
    AuthStatus       = aedf -> Status
// Only successful PKINIT - failed attempts don't confirm identity abuse
| filter AuthStatus = "0x0"
| filter CertificateUPN != null and CertificateSID != null
| filter CertificateSID != TargetSid
| filter TargetUserName ~= "\\$$"
| alter ComputerNameRaw = replace(TargetUserName, "$", "")
| alter ComputerNameKey = lowercase(ComputerNameRaw)
| join type=left (preset=ad_computers
    | fields name, userAccountControl, primaryGroupID, OU
    | alter adComputerKey = lowercase(name)) as adc
  adc.adComputerKey = ComputerNameKey
// UAC bit 13 extraction - SERVER_TRUST_ACCOUNT (0x2000 / 8192)
| alter uac_div = floor(divide(adc.userAccountControl, 8192))
| alter uac_bit13 = subtract(uac_div, multiply(floor(divide(uac_div, 2)), 2))
// Layered DC validation: UAC bit > primaryGroupID > OU fallback
| alter
    isServerTrustBit = if(adc.userAccountControl != null, uac_bit13 = 1, null),
    isPrimaryGroupDC = if(adc.primaryGroupID != null, adc.primaryGroupID = 516, null),
    isOUBackupMatch  = if(adc.OU != null, adc.OU contains "Domain Controllers", false)
| alter isKnownDC = coalesce(isServerTrustBit, isPrimaryGroupDC, isOUBackupMatch, false)
| filter isKnownDC = false
| fields _time, agent_hostname, TargetUserName, TargetSid, CertificateUPN, CertificateSID,
         CertIssuerName, CertSerialNumber, SourceIP, AuthStatus
