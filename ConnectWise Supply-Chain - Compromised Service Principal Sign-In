// ConnectWise Supply-Chain - Compromised Service Principal Sign-In
// Detects service principal sign-ins from the compromised ConnectWise Cloud Backup (506e08f9) and Cloud Management - MS Teams (24205314) application IDs.
// Reference: https://www.bleepingcomputer.com/news/security/hackers-breach-microsoft-365-tenants-via-connectwise-supply-chain-attack/
// MITRE: T1199 - Trusted Relationship, T1078.004 - Valid Accounts: Cloud Accounts


dataset = msft_azure_ad_raw
| filter appId in (
    "506e08f9-6e9a-4da4-942b-a099a03644ae",  // Cloud Backup (SkyKick) - PRIMARY
    "24205314-2b89-4e07-a2a4-579e898a5640",  // Cloud Management - MS Teams - SECONDARY
    "2399d300-6fca-4e6a-a686-399fefe75b83",  // Cloud Management
    "b78f6a77-d4e5-46fb-87e5-d1648bd02519",  // Cloud Management - Exchange Online
    "0de14c77-b9b0-4137-9360-34878a929827",  // Cloud Management - MS Graph
    "412dcf96-176d-4b3a-a1b0-4981ad66971e",  // Cloud Management - Partner Center
    "b2b55f5b-7758-4719-8d8f-88ae172e6bdb"   // Cloud Management - SharePoint Online
)
| alter
    error_code = json_extract_scalar(to_string(status), "$.errorCode"),
    Managed = json_extract_scalar(deviceDetail, "$.isManaged"),
    Compliance = json_extract_scalar(deviceDetail, "$.isCompliant"),
    Browser = json_extract_scalar(deviceDetail, "$.browser"),
    OS = json_extract_scalar(deviceDetail, "$.operatingSystem")
| alter is_attacker_ip = if(ipAddress = "144.172.64.128", "YES", "NO")
| alter is_attacker_ua = if(
    userAgent ~= "(?i)(curl\/7\.88|python-requests\/2\.31|Python-urllib\/3\.12|kiota)",
    "YES", "NO")
| alter severity = if(
    is_attacker_ip = "YES", "CRITICAL - Confirmed Attacker IP",
    if(is_attacker_ua = "YES", "HIGH - Attacker User Agent",
    "REVIEW - Verify Legitimacy"))
| fields _time, severity, appId, appDisplayName, ipAddress, userAgent, is_attacker_ip, is_attacker_ua, error_code, userPrincipalName, location, Managed, Compliance, Browser, OS
| sort desc _time
