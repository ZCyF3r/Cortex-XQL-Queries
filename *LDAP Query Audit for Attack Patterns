// LDAP Query Audit for Attack Patterns
// LDAP search operations logged by the newer audit events
// (3039/3040) introduced in Windows Server 2025. These log every LDAP query regardless of performance, including the filter, base DN, scope, and client IP. 
// Flags known attack LDAP filters for Kerberoasting recon, AS-REP roasting recon, delegation abuse, AD CS enumeration, and bulk user/computer/group enumeration.
// MITRE: T1087.002 - Account Discovery: Domain Account, T1069.002 - Permission Groups Discovery: Domain Groups


dataset = xdr_data
| filter event_type = ENUM.EVENT_LOG
| filter action_evtlog_event_id in (3039, 3040)
| alter aedf_str = to_string(action_evtlog_data_fields)
| alter
    ClientIP = arrayindex(regextract(aedf_str, "\"(?i)ClientIP\":\s*\"([^\"]+)\""), 0),
    SearchFilter = arrayindex(regextract(aedf_str, "\"(?i)SearchFilter\":\s*\"([^\"]+)\""), 0),
    BaseDN = arrayindex(regextract(aedf_str, "\"(?i)BaseDN\":\s*\"([^\"]+)\""), 0),
    Scope = arrayindex(regextract(aedf_str, "\"(?i)Scope\":\s*\"([^\"]+)\""), 0)
| alter is_spn_enum = if(SearchFilter ~= "(?i)(servicePrincipalName=\\*|servicePrincipalName)", "YES", "NO")
| alter is_asrep_enum = if(SearchFilter ~= "(?i)(userAccountControl:1.2.840.113556.1.4.803:=4194304)", "YES", "NO")
| alter is_delegation_enum = if(SearchFilter ~= "(?i)(msDS-AllowedToDelegateTo|userAccountControl:1.2.840.113556.1.4.803:=524288)", "YES", "NO")
| alter is_adcs_enum = if(SearchFilter ~= "(?i)(objectClass=pKICertificateTemplate|objectClass=certificationAuthority|pKIEnrollmentService)", "YES", "NO")
| alter is_user_enum = if(SearchFilter ~= "(?i)(objectClass=user|objectCategory=person|sAMAccountType=805306368)", "YES", "NO")
| alter is_bloodhound = if(SearchFilter ~= "(?i)(msDS-GroupMSAMembership|msDS-Allowed|adminCount=1|objectClass=trusteddomain)", "YES", "NO")
| alter query_type = if(
    is_spn_enum = "YES", "Kerberoasting Recon",
    if(is_asrep_enum = "YES", "AS-REP Roasting Recon",
    if(is_delegation_enum = "YES", "Delegation Abuse Recon",
    if(is_adcs_enum = "YES", "AD CS Enumeration",
    if(is_bloodhound = "YES", "BloodHound Collection",
    if(is_user_enum = "YES", "User Enumeration", "Other"))))))
| filter query_type != "Other"
| fields _time, agent_hostname, ClientIP, SearchFilter, BaseDN, Scope, query_type
| sort desc _time
