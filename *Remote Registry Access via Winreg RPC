// Remote Registry Access via Winreg RPC
// Detects remote registry operations through the Winreg RPC interface. Used by secretsdump to extract SAM/SECURITY/SYSTEM hives, and by various tools for remote configuration reads. Remote registry access  from non-admin workstations or unexpected IPs is suspicious.
// MITRE: T1012 - Query Registry, T1552.002 - Unsecured Credentials: Credentials in Registry


dataset = xdr_data
| alter call_fields_str = to_string(action_rpc_func_str_call_fields)
| filter event_type = ENUM.RPC_CALL
| filter action_rpc_interface_uuid = "{338CD001-2244-31F1-AAAA-900038001003}"
| filter causality_actor_type in(ENUM.REMOTE_FILE_SMB, ENUM.REMOTE_HTTP, ENUM.REMOTE_NAMED_PIPE, ENUM.REMOTE_TCP)
| alter is_sensitive_hive = if(
    call_fields_str ~= "(?i)(SAM|SECURITY|SYSTEM|NTDS)", "YES", "NO")
| comp
    count() as total_calls,
    count_distinct(agent_hostname) as distinct_targets,
    values(agent_hostname) as target_hosts,
    values(is_sensitive_hive) as sensitive_hive_access,
    values(action_rpc_func_name) as functions_called,
    min(_time) as first_seen,
    max(_time) as last_seen
  by action_rpc_username, actor_remote_ip
| filter total_calls >= 20 or sensitive_hive_access contains "YES"
| sort desc total_calls
