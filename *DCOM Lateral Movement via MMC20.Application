// DCOM Lateral Movement via MMC20.Application
// Detects remote code execution through the MMC20.Application DCOM object. Impacket dcomexec and other tools use ExecuteShellCommand on this interface for lateral movement. MMC20 DCOM calls from non-admin workstations are anomalous.
// MITRE: T1021.003 - Remote Services: Distributed Component Object Model


dataset = xdr_data
| filter event_type = ENUM.RPC_CALL
| filter action_rpc_interface_uuid = "{49B2791A-B1AE-4C90-9B8E-E860BA07F889}"
| alter call_fields_str = to_string(action_rpc_func_str_call_fields)
| fields _time, agent_hostname, action_rpc_func_name, action_rpc_func_opnum,call_fields_str, action_rpc_username, actor_remote_ip, causality_actor_type
