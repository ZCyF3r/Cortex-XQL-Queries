dataset = xdr_data
| filter event_type = ENUM.RPC_CALL
| filter action_rpc_interface_uuid = "367ABB81-9844-35F1-AD32-98F038001003"
// CreateServiceW = opnum 12, StartServiceW = opnum 19, DeleteService = opnum 2
| filter action_rpc_func_opnum in (12, 19, 2)
| alter rpc_function = if(
    action_rpc_func_opnum = 12, "CreateServiceW",
    if(action_rpc_func_opnum = 19, "StartServiceW",
    if(action_rpc_func_opnum = 2, "DeleteService", "Unknown")))
| alter call_fields_str = to_string(action_rpc_func_str_call_fields)
| fields _time, agent_hostname, os_actor_primary_username, action_rpc_interface_name, action_rpc_interface_uuid, rpc_function, action_rpc_func_opnum, action_rpc_func_name, call_fields_str, action_rpc_username, actor_remote_ip, causality_actor_type
