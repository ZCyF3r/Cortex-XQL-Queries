// Malicious RPC Calls for Lateral Movement, Coercion, and Credential Theft
// Detects known malicious RPC interface and function calls associated with lateral movement (PsExec, smbexec, atexec, wmiexec, dcomexec), authentication coercion (PetitPotam, PrinterBug, DFSCoerce, ShadowCoerce), and credential theft (DCSync, SAMR enumeration). Each detection is keyed on the specific RPC interface UUID and opnum for maximum precision.
// MITRE: T1021.002, T1569.002, T1053.005, T1047, T1187, T1003.006


dataset = xdr_data
| filter event_type = ENUM.RPC_CALL
| filter action_rpc_interface_uuid in (
    "{367ABB81-9844-35F1-AD32-98F038001003}",
    "{1FF70682-0A51-30E8-076D-740BE8CEE98B}",
    "{86D35949-83C9-4044-B424-DB363231FD0C}",
    "{9556DC99-828C-11CF-A37E-00AA003240C7}",
    "{49B2791A-B1AE-4C90-9B8E-E860BA07F889}",
    "{9BA05972-F6A8-11CF-A442-00A0C90A8F39}",
    "{C681D488-D850-11D0-8C52-00C04FD90F7E}",
    "{DF1941C5-FE89-4E79-BF10-463657ACF44D}",
    "{12345678-1234-ABCD-EF00-0123456789AB}",
    "{4FC742E0-4A10-11CF-8273-00AA004AE673}",
    "{A8E0653C-2744-4389-A61D-7373DF8B2292}",
    "{E3514235-4B06-11D1-AB04-00C04FC2DCD2}",
    "{12345778-1234-ABCD-EF00-0123456789AC}",
    "{338CD001-2244-31F1-AAAA-900038001003}")
| alter attack_category = if(
    action_rpc_interface_uuid in ("{367ABB81-9844-35F1-AD32-98F038001003}", "{1FF70682-0A51-30E8-076D-740BE8CEE98B}", "{86D35949-83C9-4044-B424-DB363231FD0C}", "{9556DC99-828C-11CF-A37E-00AA003240C7}", "{49B2791A-B1AE-4C90-9B8E-E860BA07F889}", "{9BA05972-F6A8-11CF-A442-00A0C90A8F39}"), "Lateral Movement",
    if(action_rpc_interface_uuid in ("{C681D488-D850-11D0-8C52-00C04FD90F7E}", "{DF1941C5-FE89-4E79-BF10-463657ACF44D}", "{12345678-1234-ABCD-EF00-0123456789AB}", "{4FC742E0-4A10-11CF-8273-00AA004AE673}", "{A8E0653C-2744-4389-A61D-7373DF8B2292}"), "Coercion / Auth Relay",
    "Credential Theft"))
| alter technique = if(
    action_rpc_interface_uuid = "{367ABB81-9844-35F1-AD32-98F038001003}", "PsExec / smbexec (SVCCTL)",
    if(action_rpc_interface_uuid = "{1FF70682-0A51-30E8-076D-740BE8CEE98B}", "atexec (ATSVC)",
    if(action_rpc_interface_uuid = "{86D35949-83C9-4044-B424-DB363231FD0C}", "Scheduled Task (ITaskScheduler)",
    if(action_rpc_interface_uuid = "{9556DC99-828C-11CF-A37E-00AA003240C7}", "wmiexec (IWbemServices)",
    if(action_rpc_interface_uuid = "{49B2791A-B1AE-4C90-9B8E-E860BA07F889}", "dcomexec (MMC20)",
    if(action_rpc_interface_uuid = "{9BA05972-F6A8-11CF-A442-00A0C90A8F39}", "dcomexec (ShellWindows)",
    if(action_rpc_interface_uuid in ("{C681D488-D850-11D0-8C52-00C04FD90F7E}", "{DF1941C5-FE89-4E79-BF10-463657ACF44D}"), "PetitPotam (EFSRPC)",
    if(action_rpc_interface_uuid = "{12345678-1234-ABCD-EF00-0123456789AB}", "PrinterBug (Spoolss)",
    if(action_rpc_interface_uuid = "{4FC742E0-4A10-11CF-8273-00AA004AE673}", "DFSCoerce (DFSNM)",
    if(action_rpc_interface_uuid = "{A8E0653C-2744-4389-A61D-7373DF8B2292}", "ShadowCoerce (FssAgent)",
    if(action_rpc_interface_uuid = "{E3514235-4B06-11D1-AB04-00C04FC2DCD2}", "DCSync (DRSUAPI)",
    if(action_rpc_interface_uuid = "{12345778-1234-ABCD-EF00-0123456789AC}", "SAMR Enumeration",
    "Remote Registry (Winreg)"))))))))))))
| alter call_fields_str = to_string(action_rpc_func_str_call_fields)
| fields _time, agent_hostname, attack_category, technique, action_rpc_interface_name, action_rpc_interface_uuid, action_rpc_func_name, action_rpc_func_opnum, call_fields_str, action_rpc_username, actor_remote_ip, causality_actor_type
| sort desc _time
